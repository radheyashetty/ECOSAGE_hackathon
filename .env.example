# =====================================================================
# EcoSage Configuration Environment Variables
# =====================================================================

# ── Primary LLM Provider (Google Gemini - Free Tier) ─────────────────
# Get a free API key at https://aistudio.google.com (No credit card needed)
GOOGLE_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ── Alternative Free Cloud Provider (Groq) ───────────────────────────
# Optional: Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Alternative Local Offline Provider (Ollama) ──────────────────────
# Optional: Install from https://ollama.ai (100% offline, zero keys needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Local Vector Database (ChromaDB) ─────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=ecosage_knowledge

# ── Retrieval & Confidence Calibration Thresholds ────────────────────
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.65
HIGH_CONFIDENCE_THRESHOLD=0.80

# ── Centralized Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

